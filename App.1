# --- Fetch All Binance USDT Pairs ---
@st.cache_data(ttl=600)
def get_binance_usdt_symbols():
    try:
        url = "https://api.binance.com/api/v3/ticker/price"
        response = requests.get(url, timeout=5)
        data = response.json()
        symbols = [item['symbol'] for item in data if item['symbol'].endswith('USDT')]
        return symbols
    except Exception:
        # Fallback list if offline or rate-limited
        return ["DOGEUSDT", "BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "PEPEUSDT", "ADAUSDT", "AVAXUSDT"]

all_symbols = get_binance_usdt_symbols()

# --- Initialize Session State for Auto-Switching Scanner ---
if 'scan_index' not in st.session_state:
    st.session_state.scan_index = 0
if 'last_rot_time' not in st.session_state:
    st.session_state.last_rot_time = time.time()

# --- Sidebar Configuration ---
st.sidebar.header("⚙️ Scanner Engine Controls")
scan_mode = st.sidebar.radio("Scan Mode", ["Auto-Switch (Every 10 Mins)", "Manual Selection"])

# Auto-rotation logic (10 minutes = 600 seconds)
current_time_epoch = time.time()
if scan_mode == "Auto-Switch (Every 10 Mins)":
    if current_time_epoch - st.session_state.last_rot_time > 600:
        st.session_state.scan_index = (st.session_state.scan_index + 1) % len(all_symbols)
        st.session_state.last_rot_time = current_time_epoch
    selected_asset = all_symbols[st.session_state.scan_index]
    st.sidebar.info(f"🔄 Auto-cycling active. Current asset index: {st.session_state.scan_index + 1}/{len(all_symbols)}")
else:
    selected_asset = st.sidebar.selectbox("Select Asset Manually", all_symbols, index=0)

total_capital = st.sidebar.number_input("Total Capital (USDT)", value=100000.0, step=1000.0)
leverage = st.sidebar.slider("Leverage (x)", min_value=1, max_value=50, value=10)

# --- Fetch Real-Time Market Data for Selected Asset ---
@st.cache_data(ttl=10)
def fetch_ticker_data(symbol):
    try:
        url = f"https://api.binance.com/api/v3/ticker/24hr?symbol={symbol}"
        res = requests.get(url, timeout=3).json()
        price = float(res['lastPrice'])
        high = float(res['highPrice'])
        low = float(res['lowPrice'])
        return price, high, low
    except Exception:
        return 0.073005, 0.075, 0.071

live_price, p_high, p_low = fetch_ticker_data(selected_asset)

# --- Quantitative Strategy Logic (Simulating pictures) ---
entry_price = live_price if live_price > 0 else 0.073005
take_profit = round(entry_price * 0.9985, 7)  # Target for short setup
stop_loss = round(entry_price * 1.0011, 7)     # Invalidation for short setup
trade_direction = "SHORT" if np.random.choice([True, False]) else "LONG"
quality_score = round(np.random.uniform(35.0, 78.5), 1)
bayes_prob = round(np.random.uniform(65.0, 85.0), 1)
rmt_mode = round(np.random.uniform(55.0, 70.0), 1)
scalp_time = "600s"

# Diagnostics text matching your screenshots
hawkes_val = round(np.random.uniform(-0.6, 0.6), 2)
book_imb = round(np.random.uniform(-0.5, 0.5), 2)
taker_flow = round(np.random.uniform(-0.8, 0.2), 2)
is_qualified = quality_score >= 50.0

# --- Header Section ---
st.markdown("# TRADE HUNTING ENGINE")
st.markdown("---")

# --- Main Layout Grid ---
col1, col2, col3 = st.columns(3)

with col1:
    dir_color = '#ff3366' if trade_direction == 'SHORT' else '#2ecc71'
    st.markdown(f'<div class="metric-box"><div class="metric-title">Target Asset & Mode</div><div style="font-size: 18px; color: {dir_color}; font-weight: bold;">{selected_asset} {trade_direction}</div><div style="font-size: 12px; color: #ffffff; margin-top: 4px;">QUALITY SCORE: <b>{quality_score}</b></div></div>', unsafe_allow_html=True)
    st.markdown(f'<div class="metric-box"><div class="metric-title">Entry Price</div><div style="font-size: 16px; color: #00ffcc; font-weight: bold;">{entry_price:.6f}</div></div>', unsafe_allow_html=True)
    st.markdown(f'<div class="metric-box"><div class="metric-title">Leverage</div><div style="font-size: 16px; color: #ffffff; font-weight: bold;">{leverage}x</div></div>', unsafe_allow_html=True)

with col2:
    st.markdown(f'<div class="metric-box"><div class="metric-title">Take Profit</div><div style="font-size: 16px; color: #2ecc71; font-weight: bold;">{take_profit}</div></div>', unsafe_allow_html=True)
    st.markdown(f'<div class="metric-box"><div class="metric-title">Stop Loss</div><div style="font-size: 16px; color: #e74c3c; font-weight: bold;">{stop_loss}</div></div>', unsafe_allow_html=True)
    st.markdown(f'<div class="metric-box"><div class="metric-title">P(Direction) & Scalp Time</div><div style="font-size: 16px; color: #00ffcc; font-weight: bold;">{bayes_prob}% <span style="font-size:12px; color:#8a99ad;">({scalp_time})</span></div></div>', unsafe_allow_html=True)

with col3:
    st.markdown(f'<div class="metric-box"><div class="metric-title">Total Capital</div><div style="font-size: 16px; color: #ffffff; font-weight: bold;">{total_capital:,.2f} USDT</div></div>', unsafe_allow_html=True)
    st.markdown(f'<div class="metric-box"><div class="metric-title">RMT Market Mode</div><div style="font-size: 16px; color: #00ffcc; font-weight: bold;">{rmt_mode}%</div></div>', unsafe_allow_html=True)
    formatted_time = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    st.markdown(f'<div class="metric-box"><div class="metric-title">Last Scan Timestamp</div><div style="font-size: 13px; color: #00ffcc; font-weight: bold; margin-top: 5px;">{formatted_time}</div></div>', unsafe_allow_html=True)

# --- Qualification Status Banner (Matching Screen 2 & 5) ---
st.markdown("---")
